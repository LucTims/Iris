  "chunks": [
    {"text": "Voici Awa,", "hl": ["Awa,"]},
    {"text": "couturière à Abidjan", "hl": ["Abidjan"]},
    {"text": "depuis plus de 15 ans.", "hl": ["15", "ans."]},
    {"text": "Elle sait faire ce qu'on n'enseigne"},
    {"text": "même pas dans les centres de formation.", "hl": ["formation."]},
    {"text": "Plus de 15 ans d'expérience du terrain…", "hl": ["terrain…"]},
    {"text": "des astuces que personne d'autre ne connaît.", "hl": ["astuces"]},
    {"text": "Elle te coupe un boubou sans patron.", "hl": ["boubou", "patron."]},
    {"text": "Elle sauve un pagne", "hl": ["pagne"]},
    {"text": "que tout le monde croyait perdu.", "hl": ["perdu."]},
    {"text": "Mais Awa a un problème :", "hl": ["problème"]},
    {"text": "elle ne sait pas comment monétiser ce savoir,", "hl": ["monétiser"]},
    {"text": "ni comment le partager avec les autres.", "hl": ["partager"]},
    {"text": "Ses apprenties partent avec ses secrets.", "hl": ["secrets."]},
    {"text": "Ses voisines copient ses modèles.", "hl": ["copient"]},
    {"text": "Et Awa ?", "hl": ["Awa"]},
    {"text": "Pas un franc pour tout ce qu'elle sait.", "hl": ["franc"]},
    {"text": "Parce qu'Awa n'est pas écrivaine.", "hl": ["écrivaine."]},
    {"text": "Et puis, un jour,"},
    {"text": "elle découvre Iris.", "hl": ["Iris."]},
    {"text": "Une plateforme pour écrire des livres,", "hl": ["livres,"]},
    {"text": "simple, facile à utiliser.", "hl": ["simple,", "facile"]},
    {"text": "Ce qui prend des mois à écrire…", "hl": ["mois"]},
    {"text": "Awa l'a fait en moins de 24 heures,", "hl": ["24", "heures,"]},
    {"text": "avec un seul outil.", "hl": ["outil."]},
    {"text": "Et aujourd'hui, son savoir-faire", "hl": ["savoir-faire"]},
    {"text": "est un vrai livre, prêt à être vendu.", "hl": ["livre,", "vendu."]},
    {"text": "Ce qu'elle donnait gratuitement…", "hl": ["gratuitement…"]},
    {"text": "aujourd'hui, ça se vend.", "hl": ["vend."]},
    {"text": "Et toi ?", "hl": ["toi"]},
    {"text": "Quelle est cette compétence", "hl": ["compétence"]},
    {"text": "que tu rêves de monétiser depuis longtemps ?", "hl": ["monétiser"]},
    {"text": "Dis-le-moi en commentaire.", "hl": ["commentaire."]}
