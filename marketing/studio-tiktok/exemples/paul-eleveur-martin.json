        "générique"
      ]
    },
    {
      "text": "son expérience, son terrain,",
      "hl": [
        "expérience,",
        "terrain,"
      ]
    },
    {
      "text": "ses conseils.",
      "hl": [
        "conseils."
      ]
    },
    {
      "text": "Et il peut tout modifier,",
      "hl": [
        "modifier,"
      ]
    },
    {
      "text": "pas à pas,"
    },
    {
      "text": "sans tout recommencer.",
      "hl": [
        "recommencer."
      ]
    },
    {
      "text": "À la fin,"
    },
    {
      "text": "il crée sa couverture.",
      "hl": [
        "couverture."
      ]
    },
    {
      "text": "Douze ans d'expérience…",
      "hl": [
        "expérience…"
      ]
